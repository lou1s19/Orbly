	<!-- Beliebige Adressen bleiben erlaubt: Ein eigener Transkriptions-Server im
	     LAN läuft typischerweise ohne TLS-Zertifikat. Die App warnt an dieser
	     Stelle sichtbar (settings.serverURL.insecure).
	     Für die beiden Adressen, die Orbly selbst ansteuert, gilt das NICHT:
	     Dort bleibt TLS Pflicht, sonst könnte eine Umleitung von HTTPS auf HTTP
	     den Modell-Download und die Update-Suche mitlesbar machen. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>huggingface.co</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<false/>
				<key>NSIncludesSubdomains</key>
